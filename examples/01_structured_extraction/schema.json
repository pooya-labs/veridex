{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomerTicketExtraction",
  "type": "object",
  "required": ["ticket_id", "category", "urgency", "summary"],
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["billing", "technical", "account", "feedback"]
    },
    "urgency": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "summary": {
      "type": "string"
    },
    "user_id": {
      "type": "integer"
    }
  }
}
